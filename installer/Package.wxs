<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- Keep the UpgradeCode forever: it is how new versions find and replace the installed one. -->
  <Package Name="LeafSide"
           Manufacturer="Jorge Zapata"
           Version="$(var.ProductVersion)"
           UpgradeCode="8CC82BAE-5629-4DED-BE91-97E1D4EAD2A3"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.RepoRoot)\src\PdfReader.App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Jmzp/winui-pdf-reader" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Jmzp/winui-pdf-reader/issues" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- %LocalAppData%\Programs\LeafSide: the usual place for per-user apps. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="LeafSide" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenu" />
      <ComponentRef Id="FileAssociation" />
    </Feature>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu">
        <Shortcut Id="StartMenuShortcut" Name="LeafSide" Description="Fast PDF reader"
                  Target="[INSTALLFOLDER]LeafSide.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\PdfReader" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        <!-- Tells the app it was installed with this package, so its update check offers the installer (not the zip). -->
        <RegistryValue Root="HKCU" Key="Software\PdfReader" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" />
      </Component>
    </StandardDirectory>

    <!-- "Open with" for .pdf: the same keys the app writes itself (Services/FileAssociation.cs), so it works right
         after installing and uninstalling removes them. They are written through HKCR, which Windows Installer maps
         to HKCU\Software\Classes in a per-user install. On a machine where Windows refuses them (seen after
         earlier registrations of the same ProgID), the app still registers itself when it first starts. -->
    <Component Id="FileAssociation" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKCR" Key="LeafSide.Document">
        <RegistryValue Type="string" Value="PDF Document" />
        <RegistryValue Name="FriendlyTypeName" Type="string" Value="PDF Document" />
        <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]LeafSide.exe&quot;,0" />
        <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]LeafSide.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
      <RegistryValue Root="HKCR" Key=".pdf\OpenWithProgids" Name="LeafSide.Document" Type="string" Value="" />
      <RegistryKey Root="HKCR" Key="Applications\LeafSide.exe">
        <RegistryValue Name="FriendlyAppName" Type="string" Value="LeafSide" />
        <RegistryValue Key="SupportedTypes" Name=".pdf" Type="string" Value="" />
        <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]LeafSide.exe&quot; &quot;%1&quot;" />
      </RegistryKey>
      <!-- The app may have added values of its own (localized names): remove the whole keys. -->
      <RemoveRegistryKey Action="removeOnUninstall" Root="HKCR" Key="LeafSide.Document" />
      <RemoveRegistryKey Action="removeOnUninstall" Root="HKCR" Key="Applications\LeafSide.exe" />
      <RegistryValue Root="HKCU" Key="Software\PdfReader" Name="FileAssociation" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- UI: license, install, and an option to start the app at the end. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open LeafSide" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <SetProperty Id="WixShellExecTarget" Value="[INSTALLFOLDER]LeafSide.exe" After="CostFinalize" Sequence="both" />
    <CustomAction Id="LaunchApp" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
