<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PdfReader.App</RootNamespace>
    <AssemblyName>PdfReader</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
    <!-- UI strings: Strings/en-US (default) and Strings/es. -->
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Program.cs provides Main (single instance). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PdfiumArch>win-arm64</PdfiumArch>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' != 'ARM64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PdfiumArch>win-x64</PdfiumArch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfReader.Core\PdfReader.Core.csproj" />
    <!-- Native PDFium matching the target architecture (ARM64 builds run natively on Snapdragon devices). -->
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\native\pdfium\$(PdfiumArch)\bin\pdfium.dll" Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Unpackaged publish omits the app's compiled XAML (*.xbf) and resource index (.pri); without them the
       window fails to load. Copy them from the build output. -->
  <Target Name="CopyXamlResourcesToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <_AppXamlResources Include="$(OutDir)$(AssemblyName).pri;$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_AppXamlResources)"
          DestinationFiles="@(_AppXamlResources->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
